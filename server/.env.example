# Required for KI-Analyse, KI-Firmenbericht, Kündigungs-Assistent
ANTHROPIC_API_KEY=

# Optional: 32-byte key, base64-encoded, for encrypting stored subscription passwords.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If omitted, a key is auto-generated into server/data/.encryption.key on first run (dev only).
ENCRYPTION_KEY=

PORT=8787
