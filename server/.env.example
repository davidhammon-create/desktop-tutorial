# Optional fallback for KI-Analyse, KI-Firmenbericht, Kündigungs-Assistent, KI-Auto-Check.
# Normally you enter the key once in the app under Konto → KI-Zugang, and it's
# saved locally in your app-data folder — no .env file needed for everyday use.
# This env var is only useful for local development without the UI flow.
ANTHROPIC_API_KEY=

# Optional: 32-byte key, base64-encoded, for encrypting stored subscription passwords.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If omitted, a key is auto-generated on first run and stored in your app-data folder.
ENCRYPTION_KEY=

PORT=8787
