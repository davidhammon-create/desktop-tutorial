<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Anzeige -->
    <key>CFBundleDisplayName</key>
    <string>LegalOS</string>
    <key>CFBundleName</key>
    <string>LegalOS</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>MinimumOSVersion</key>
    <string>17.0</string>

    <!-- App Transport Security – Anthropic ist HTTPS, keine Ausnahmen nötig. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>

    <!-- iCloud / CloudKit – Container-ID hier eintragen.
         Format: iCloud.com.deinefirma.legalos -->
    <key>NSUbiquitousContainers</key>
    <dict>
        <key>iCloud.com.example.legalos</key>
        <dict>
            <key>NSUbiquitousContainerIsDocumentScopePublic</key>
            <false/>
            <key>NSUbiquitousContainerName</key>
            <string>LegalOS</string>
            <key>NSUbiquitousContainerSupportedFolderLevels</key>
            <string>Any</string>
        </dict>
    </dict>

    <!-- Hinweise / Begründungen für sensible APIs -->
    <key>NSUserTrackingUsageDescription</key>
    <string>Wird in LegalOS nicht verwendet.</string>
    <key>NSContactsUsageDescription</key>
    <string>Optional: Mandanten aus Kontakten importieren.</string>

    <!-- Sign in with Apple wird über die Entitlements aktiviert -->

    <!-- Hauptfenster (macOS) -->
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <key>UILaunchScreen</key>
    <dict/>
</dict>
</plist>
