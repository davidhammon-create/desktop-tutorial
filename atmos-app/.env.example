# Supabase (optional legacy Lexara routes)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# ?? AtmOS Google APIs ??
# Prefer ATMOS_* names (also used as Cursor app secrets). Local Vite exposes them via envPrefix.
# Without these keys the app runs in demo mode (katalog + demo Google hits).
# Gemini / Generative Language API key (also powers ranking hints)
ATMOS_GOOGLE_API_KEY=
# Programmable Search Engine ID (Custom Search JSON API) ? required together with the API key for live /suche
ATMOS_GOOGLE_CSE_ID=
# Optional model override (default gemini-2.0-flash)
ATMOS_GEMINI_MODEL=gemini-2.0-flash
# Aliases also accepted:
# VITE_GOOGLE_API_KEY=
# VITE_GOOGLE_CSE_ID=
# VITE_GEMINI_API_KEY=
