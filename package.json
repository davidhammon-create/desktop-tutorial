{
  "name": "modellsammlung",
  "version": "2.0.0",
  "description": "Interaktive 3D-Modelle auf Universitätsniveau für Physik, Chemie, Biologie und Medizin",
  "author": "David Hammon",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "icons": "python3 scripts/icons.py",
    "build:electron": "vite build --mode electron",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:pack": "npm run build:electron && electron-builder --dir",
    "electron:build": "npm run build:electron && electron-builder",
    "electron:build:win": "npm run build:electron && electron-builder --win",
    "electron:build:mac": "npm run build:electron && electron-builder --mac",
    "electron:build:linux": "npm run build:electron && electron-builder --linux",
    "pdf": "python3 scripts/code2pdf.py"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1",
    "vite": "^4.4.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
